{
    "env": {
        "myDefaultIncludePath": [
            "${workspaceFolder}"
        ],
        "myCompilerPath": "/opt/cray/pe/gcc-native/14/bin/gcc"
    },
    "configurations": [
        {
            "name": "Linux GCC native",
            "intelliSenseMode": "gcc-x64",
            "includePath": [
                "${myDefaultIncludePath}"
            ],
            "compilerPath": "${myCompilerPath}",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "browse": {
                "path": [
                    "${workspaceFolder}"
                ],
                "limitSymbolsToIncludedHeaders": true,
                "databaseFilename": ""
            }
        }
    ],
    "version": 4
}